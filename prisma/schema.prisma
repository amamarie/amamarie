  @@index([alertId])
  @@index([clientId])
  @@index([status])
  @@index([inputHash])
}

model PriorityItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  advisorId String?
  advisor   User?   @relation("PriorityAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  entityType PriorityEntityType
  entityId   String

  level  PriorityLevel
  status PriorityStatus @default(ACTIVE)

  score             Int
  urgencyScore      Int @default(0)
  complianceScore   Int @default(0)
  relationshipScore Int @default(0)
  commercialScore   Int @default(0)
  freshnessScore    Int @default(0)
  effortScore       Int @default(0)

  title           String
  description     String?
  reason          String?
  suggestedAction String?
  actionUrl       String?

  dueAt           DateTime?
  snoozedUntil    DateTime?
  completedAt     DateTime?
  dismissedAt     DateTime?
  dismissedReason String?

  metadata Json?

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId])
  @@index([advisorId])
  @@index([clientId])
  @@index([leadId])
  @@index([level])
  @@index([status])
  @@index([score])
  @@index([dueAt])
}

model PriorityRun {
