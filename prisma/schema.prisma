  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  advisorId String?
  advisor   User?   @relation("ComplianceExceptionAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)

  requestedById String?
  requestedBy   User?   @relation("ComplianceExceptionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?   @relation("ComplianceExceptionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  exceptionType        String
  reason               String
  riskLevel            String    @default("MEDIUM")
  status               String    @default("REQUESTED")
  supportingDocumentId String?
  linkedEntityType     String?
  linkedEntityId       String?
  approvedAt           DateTime?
  expiresAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([advisorId])
  @@index([exceptionType])
  @@index([riskLevel])
  @@index([status])
}

model Complaint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  advisorId String?
  advisor   User?   @relation("ComplaintAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  complaintNumber   String
  receivedAt        DateTime  @default(now())
  channel           String?
  productType       String?
  category          String?
  description       String
  severity          String    @default("MEDIUM")
  status            String    @default("OPEN")
  acknowledgedAt    DateTime?
  resolutionSummary String?
  closedAt          DateTime?
  reportableToAmf   Boolean   @default(false)
  documents         Json?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, complaintNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([advisorId])
  @@index([assignedToId])
  @@index([status])
  @@index([severity])
  @@index([receivedAt])
}

model ComplianceIncident {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  detectedById String?
  detectedBy   User?   @relation("ComplianceIncidentDetectedBy", fields: [detectedById], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("ComplianceIncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  incidentNumber      String
  incidentType        String
  occurredAt          DateTime?
  detectedAt          DateTime  @default(now())
  affectedClientIds   Json?
  dataCategories      Json?
  description         String
  riskLevel           String    @default("TO_ASSESS")
  seriousHarmRisk     Boolean   @default(false)
  mitigationSteps     String?
  notifiedAuthorityAt DateTime?
  notifiedClientsAt   DateTime?
  status              String    @default("OPEN")
  closedAt            DateTime?
  correctiveActions   String?
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, incidentNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([detectedById])
  @@index([assignedToId])
  @@index([incidentType])
  @@index([riskLevel])
  @@index([status])
  @@index([detectedAt])
}

model AuditReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

