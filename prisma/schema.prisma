  crossSellOpportunityId String?
  crossSellOpportunity   CrossSellOpportunity? @relation(fields: [crossSellOpportunityId], references: [id], onDelete: SetNull)
  notes                  Note[]
  documents              Document[]
  activities             Activity[]

  type        TaskType   @default(FOLLOW_UP)
  title       String
  description String?
  outcome     String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(NORMAL)
  dueDate     DateTime?
  startDate   DateTime?

  completedAt  DateTime?
  cancelledAt  DateTime?
  snoozedUntil DateTime?

  cancelReason String?
  snoozeReason String?

  isAutomated      Boolean @default(false)
  automationRuleId String?

  reminderAt     DateTime?
  reminderSentAt DateTime?

  recurrenceRule String?
