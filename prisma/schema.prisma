model SmartReminderRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code                 String
  name                 String
  description          String?
  category             String
  sourceEntityType     String
  conditionConfig      Json?
  actionConfig         Json?
  defaultPriority      String  @default("NORMAL")
  defaultDueOffsetDays Int     @default(7)
  active               Boolean @default(true)

  reminders SmartReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([category])
  @@index([active])
}

model SmartReminder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  advisorId String?
  advisor   User?   @relation("SmartReminderAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)

  ruleId String?
  rule   SmartReminderRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  title             String
  description       String?
  reason            String
  category          String
  priority          String    @default("NORMAL")
  status            String    @default("OPEN")
  triggerDate       DateTime  @default(now())
  dueDate           DateTime?
  sourceEntityType  String?
  sourceEntityId    String?
  recommendedAction String?
  actionUrl         String?
  opportunityId     String?
  snoozedUntil      DateTime?
  resolvedAt        DateTime?
  resolvedById      String?
  resolutionNote    String?
  ignoredAt         DateTime?
  ignoredById       String?
  ignoredReason     String?
  priorityScore     Int       @default(0)
  urgencyScore      Int       @default(0)
  riskScore         Int       @default(0)
  commercialScore   Int       @default(0)
  relationshipScore Int       @default(0)
  dedupeKey         String
  metadata          Json?

  actions   SmartReminderAction[]
  snoozes   SmartReminderSnooze[]
  auditLogs SmartReminderAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId])
  @@index([clientId])
  @@index([advisorId])
  @@index([ruleId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([category])
  @@index([sourceEntityType, sourceEntityId])
}

model SmartReminderAction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reminderId String
  reminder   SmartReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  actionType        String
  status            String    @default("PENDING")
  createdEntityType String?
  createdEntityId   String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  metadata          Json?

  @@index([organizationId])
  @@index([reminderId])
  @@index([actionType])
  @@index([status])
}

model SmartReminderSnooze {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reminderId String
  reminder   SmartReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  snoozedById  String?
  snoozedUntil DateTime
  reason       String
  createdAt    DateTime @default(now())

  @@index([organizationId])
  @@index([reminderId])
  @@index([snoozedUntil])
}

model SmartReminderTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category         String
  channel          String  @default("INTERNAL")
  language         String  @default("FR")
  subjectTemplate  String
  bodyTemplate     String
  requiresApproval Boolean @default(true)
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([channel])
  @@index([active])
}

model SmartReminderAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reminderId String
  reminder   SmartReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  eventType String
  userId    String?
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([organizationId])
  @@index([reminderId])
  @@index([eventType])
  @@index([timestamp])
}

model AiUsageLog {
  id             String  @id @default(cuid())
  organizationId String
  userId         String?

  feature   String
  model     String
  status    String
  inputHash String?
  error     String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([feature])
  @@index([status])
  @@index([createdAt])
}
