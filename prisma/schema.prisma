  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([type])
}

